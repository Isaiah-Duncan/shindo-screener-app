# PyInstaller build output, regenerated by the build command in BUILD.md,
# never something to track in source control.
build/
dist/
*.spec

# Python bytecode cache
__pycache__/
*.pyc

# Local per-machine app state (home location, alert settings), specific
# to whoever ran the app, not something to ship or share.
settings.json

# Scratch directory from the alert-sound comparison exercise, not part
# of the shipped app.
alert-samples/

# OS cruft
.DS_Store
Thumbs.db
